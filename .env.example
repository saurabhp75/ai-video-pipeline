# AI Video Pipeline — Environment Variables
# Copy this file to .env and fill in your keys

# ─── Required ───

# fal.ai API key (for video generation via Kling)
# Get one at: https://fal.ai
FAL_KEY=your_fal_api_key

# Opencode Go API key (for text generation via DeepSeek V4 Pro)
OPENCODE_API_KEY=your_opencode_api_key

# ─── Optional (for enhanced features) ───

# Suno API key (for AI-generated background music)
# Get one at: https://suno.com
SUNO_API_KEY=your_suno_api_key

# ─── whisper.cpp (local transcription — no API key needed) ───

# Requires whisper.cpp built and ffmpeg-full installed:
#   brew install ffmpeg-full
#   cd /Users/saurabh/dev/projects/whisper.cpp && cmake -B build && cmake --build build -j
#   cd /Users/saurabh/dev/projects/whisper.cpp && bash models/download-ggml-model.sh base.en

# Path to whisper-cli binary (default: auto-detected from /Users/saurabh/dev/projects/whisper.cpp)
# WHISPER_CPP_BINARY=/Users/saurabh/dev/projects/whisper.cpp/build/bin/whisper-cli

# Path to whisper model (default: ggml-base.en.bin for English)
# WHISPER_CPP_MODEL=/Users/saurabh/dev/projects/whisper.cpp/models/ggml-base.en.bin

# Path to ffmpeg binary (default: ffmpeg-full from Homebrew, for libass subtitle rendering)
# WHISPER_CPP_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# ─── YouTube Publishing (OAuth 2.0) ───

# Option A: Service Account (recommended for automation)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
YOUTUBE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
YOUTUBE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----

# Option B: OAuth interactive (first run opens browser)
# Download OAuth credentials JSON from Google Cloud Console
# Save as youtube-credentials.json in project root
# First run will prompt for browser authentication

# Option C: Manual auth code (paste after browser login)
YOUTUBE_AUTH_CODE=
